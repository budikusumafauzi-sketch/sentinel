// Sentinel — Prisma Schema
// Phase 3: Backend + Database Foundation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────
// Enums
// ──────────────────────────────────────────

enum DevicePlatform {
  ANDROID
  IOS
  WINDOWS
  MACOS
  LINUX
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ScanType {
  QUICK
  FULL
  CUSTOM
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
  FALSE_POSITIVE
}

enum FindingCategory {
  SYSTEM
  APPLICATION
  NETWORK
  PRIVACY
  AUTHENTICATION
  ENCRYPTION
  PERMISSIONS
  UPDATE
  CONFIGURATION
  OTHER
}

enum RecommendationPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum RecommendationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DISMISSED
  EXPIRED
}

// ──────────────────────────────────────────
// Models
// ──────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // bcrypt hash, never plaintext
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  devices         Device[]
  scans           Scan[]
  securityScores  SecurityScore[]

  @@map("users")
}

model Device {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  name         String
  platform     DevicePlatform
  osVersion    String?        @map("os_version")
  model        String?
  manufacturer String?
  isActive     Boolean        @default(true) @map("is_active")
  lastSeenAt   DateTime?      @map("last_seen_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans          Scan[]
  securityScores SecurityScore[]

  @@index([userId])
  @@map("devices")
}

model Scan {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  deviceId    String     @map("device_id")
  type        ScanType   @default(QUICK)
  status      ScanStatus @default(PENDING)
  startedAt   DateTime?  @map("started_at")
  completedAt DateTime?  @map("completed_at")
  summary     String?
  rawEvidence Json?      @map("raw_evidence")
  capabilities Json?     @map("capabilities")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  device   Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  findings Finding[]

  @@index([userId])
  @@index([deviceId])
  @@index([status])
  @@map("scans")
}

model Finding {
  id             String          @id @default(uuid())
  scanId         String          @map("scan_id")
  category       FindingCategory
  title          String
  description    String?
  severity       FindingSeverity
  status         FindingStatus   @default(OPEN)
  source         String?
  platform       DevicePlatform?
  confidence     Float?
  evidence       Json?
  explanation    String?
  remediation    String?
  resolvedAt     DateTime?       @map("resolved_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  scan            Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]

  @@index([scanId])
  @@index([severity])
  @@index([status])
  @@map("findings")
}

model SecurityScore {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  deviceId      String   @map("device_id")
  overallScore  Int      @map("overall_score")
  categoryScores Json?   @map("category_scores")
  calculatedAt  DateTime @default(now()) @map("calculated_at")
  createdAt     DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([calculatedAt])
  @@map("security_scores")
}

model Recommendation {
  id          String               @id @default(uuid())
  findingId   String?              @map("finding_id")
  title       String
  description String?
  priority    RecommendationPriority
  status      RecommendationStatus @default(PENDING)
  actionUrl   String?              @map("action_url")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  finding Finding? @relation(fields: [findingId], references: [id], onDelete: SetNull)

  @@index([findingId])
  @@index([priority])
  @@index([status])
  @@map("recommendations")
}
