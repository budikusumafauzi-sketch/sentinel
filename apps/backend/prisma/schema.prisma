// Sentinel — Prisma Schema
// Phase 3: Backend + Database Foundation
// Phase 5: Security Evidence + Deterministic Security Engine

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────
// Enums
// ──────────────────────────────────────────

enum DevicePlatform {
  ANDROID
  IOS
  WINDOWS
  MACOS
  LINUX
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum ScanType {
  QUICK
  FULL
  CUSTOM
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
  FALSE_POSITIVE
}

enum FindingCategory {
  DEVICE
  APPLICATIONS
  ACCOUNTS
  SYSTEM
  APPLICATION
  NETWORK
  PRIVACY
  AUTHENTICATION
  ENCRYPTION
  PERMISSIONS
  UPDATE
  CONFIGURATION
  OTHER
}

enum RecommendationPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum RecommendationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DISMISSED
  EXPIRED
}

// ──────────────────────────────────────────
// Models
// ──────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // bcrypt hash, never plaintext
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  devices           Device[]
  scans             Scan[]
  securityScores    SecurityScore[]
  securityHistories SecurityHistory[]
  securityEvents    SecurityEvent[]

  @@map("users")
}

model Device {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  name         String
  platform     DevicePlatform
  osVersion    String?        @map("os_version")
  model        String?
  manufacturer String?
  isActive     Boolean        @default(true) @map("is_active")
  lastSeenAt   DateTime?      @map("last_seen_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans             Scan[]
  securityScores    SecurityScore[]
  securityHistories SecurityHistory[]
  securityEvents    SecurityEvent[]

  @@index([userId])
  @@map("devices")
}

model Scan {
  id                 String     @id @default(uuid())
  userId             String     @map("user_id")
  deviceId           String     @map("device_id")
  type               ScanType   @default(QUICK)
  status             ScanStatus @default(PENDING)
  score              Int?
  evaluatedControls  Int?       @map("evaluated_controls")
  unavailableChecks  Int?       @map("unavailable_checks")
  report             Json?
  startedAt          DateTime?  @map("started_at")
  completedAt        DateTime?  @map("completed_at")
  summary            String?
  rawEvidence        Json?      @map("raw_evidence")
  capabilities       Json?      @map("capabilities")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  device            Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  findings          Finding[]
  securityScores    SecurityScore[]
  securityHistories SecurityHistory[]
  securityEvents    SecurityEvent[]

  @@index([userId])
  @@index([deviceId])
  @@index([status])
  @@map("scans")
}

model Finding {
  id             String          @id @default(uuid())
  scanId         String          @map("scan_id")
  deviceId       String?         @map("device_id")
  fingerprint    String?
  ruleId         String?         @map("rule_id")
  rulesetVersion String?         @map("ruleset_version")
  category       FindingCategory
  title          String
  description    String?
  severity       FindingSeverity
  riskScore      Int?            @map("risk_score")
  priority       String?
  status         FindingStatus   @default(OPEN)
  source         String?
  platform       DevicePlatform?
  confidence     Float?
  evidence       Json?
  explanation    String?
  remediation    String?
  resolvedAt     DateTime?       @map("resolved_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  scan            Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]

  @@index([scanId])
  @@index([deviceId])
  @@index([fingerprint])
  @@index([severity])
  @@index([status])
  @@map("findings")
}

model SecurityScore {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  deviceId              String    @map("device_id")
  scanId                String?   @map("scan_id")
  overallScore          Int       @map("overall_score")
  scoreVersion          String?   @map("score_version")
  riskModelVersion      String?   @map("risk_model_version")
  rulesetVersion        String?   @map("ruleset_version")
  evaluatedControlCount Int?      @map("evaluated_control_count")
  unavailableCheckCount Int?      @map("unavailable_check_count")
  categoryScores        Json?     @map("category_scores")
  findingContributions  Json?     @map("finding_contributions")
  calculatedAt          DateTime  @default(now()) @map("calculated_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  scan   Scan?  @relation(fields: [scanId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deviceId])
  @@index([scanId])
  @@index([calculatedAt])
  @@map("security_scores")
}

model Recommendation {
  id                 String                 @id @default(uuid())
  findingId          String?                @map("finding_id")
  deviceId           String?                @map("device_id")
  findingFingerprint String?                @map("finding_fingerprint")
  category           String?
  title              String
  description        String?
  priority           RecommendationPriority
  status             RecommendationStatus   @default(PENDING)
  actionUrl          String?                @map("action_url")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  finding Finding? @relation(fields: [findingId], references: [id], onDelete: SetNull)

  @@index([findingId])
  @@index([deviceId])
  @@index([findingFingerprint])
  @@index([priority])
  @@index([status])
  @@map("recommendations")
}

model SecurityHistory {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  deviceId          String   @map("device_id")
  scanId            String   @map("scan_id")
  overallScore      Int?     @map("overall_score")
  categoryScores    Json?    @map("category_scores")
  findingCounts     Json?    @map("finding_counts")
  evaluatedControls Int      @default(0) @map("evaluated_controls")
  unavailableChecks Int      @default(0) @map("unavailable_checks")
  coverage          Float    @default(0.0)
  status            String   @default("COMPLETED")
  trend             String   @default("INITIAL")
  scoreDelta        Int?     @map("score_delta")
  recordedAt        DateTime @default(now()) @map("recorded_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  scan   Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([scanId])
  @@index([recordedAt])
  @@map("security_histories")
}

model SecurityEvent {
  id                 String           @id @default(uuid())
  userId             String           @map("user_id")
  deviceId           String           @map("device_id")
  scanId             String?          @map("scan_id")
  findingFingerprint String?          @map("finding_fingerprint")
  type               String
  title              String
  description        String
  severity           FindingSeverity?
  metadata           Json?
  createdAt          DateTime         @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  scan   Scan?  @relation(fields: [scanId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deviceId])
  @@index([scanId])
  @@index([createdAt])
  @@map("security_events")
}
