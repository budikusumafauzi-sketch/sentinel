# Sentinel Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env files with real secrets.

NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://sentinel:sentinel_dev@localhost:5433/sentinel?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# Phase 7: AI Intelligence (Gemini)
# Never commit real API keys to version control.
SENTINEL_GEMINI_API_KEY=your_gemini_api_key_here
SENTINEL_GEMINI_MODEL=gemini-3.6-flash

# Phase 8: Threat Intelligence
# Approved external sources (CISA KEV, OSV.dev, OpenPhish, URLhaus feed) operate with zero credentials.
# Optional API keys enable direct provider API lookups with higher rate limits.
# THREAT_INTEL_URLHAUS_API_KEY=your_abuse_ch_auth_key_here
THREAT_INTEL_CACHE_TTL_SECONDS=3600
THREAT_INTEL_REQUEST_TIMEOUT_MS=5000

