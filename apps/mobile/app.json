{
  "expo": {
    "name": "Sentinel",
    "slug": "sentinel",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "sentinel",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "icon": "./assets/images/sentinel-icon-light.png",
    "android": {
      "package": "com.sentinel.app",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/sentinel-adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "bundleIdentifier": "com.sentinel.app",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/sentinel-favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}