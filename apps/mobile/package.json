{
  "name": "@sentinel/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Sentinel mobile application — React Native + Expo",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
